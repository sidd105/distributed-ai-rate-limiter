{
  "name": "distributed-ai-rate-limiter",
  "version": "0.1.0",
  "private": true,
  "description": "Redis and Lua based distributed token-bucket limiter for AI workloads",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node dist/src/server.js",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "vitest run --dir tests/unit",
    "test:integration": "node scripts/integration.mjs",
    "test:all": "npm run test && npm run test:integration",
    "check": "npm run typecheck && npm run lint && npm run format && npm run test"
  },
  "dependencies": {
    "pino": "9.9.4",
    "prom-client": "15.1.3",
    "redis": "5.8.2"
  },
  "devDependencies": {
    "@eslint/js": "9.35.0",
    "@types/node": "22.18.1",
    "esbuild": "^0.28.2",
    "eslint": "9.35.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.6.2",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "typescript-eslint": "8.71.0",
    "vitest": "^4.1.11"
  }
}
